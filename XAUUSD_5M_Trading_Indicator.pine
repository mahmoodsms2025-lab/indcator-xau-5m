//@version=5
strategy("XAUUSD 5M Pro Trading Strategy", shorttitle="XAU PRO", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=1000, commission_type=strategy.commission.percent, commission_value=0.001)

// ============================================
// INPUTS
// ============================================

pivotLookback = input.int(2, title="Pivot Lookback", minval=1, maxval=5)
rsiLen = input.int(14, title="RSI Length", minval=5, maxval=50)
rsiBullish = input.int(30, title="RSI Bullish Level", minval=5, maxval=50)
rsiBearish = input.int(70, title="RSI Bearish Level", minval=50, maxval=95)
atrLen = input.int(14, title="ATR Length", minval=5, maxval=50)
atrMult = input.float(1.5, title="ATR Multiplier", minval=0.1, maxval=5.0, step=0.1)
fib618 = input.float(0.618, title="Fib 0.618", minval=0.5, maxval=0.8, step=0.01)
fib50 = input.float(0.5, title="Fib 0.5", minval=0.3, maxval=0.6, step=0.01)
slPercent = input.float(2.0, title="Stop Loss %", minval=0.5, maxval=10.0, step=0.1)
showAlerts = input.bool(true, title="Show Alerts")
showLabels = input.bool(true, title="Show Labels")

// ============================================
// CALCULATIONS
// ============================================

rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

// Detect Pivots
isHH = high[pivotLookback] > high[pivotLookback + 1] and high[pivotLookback] > high[pivotLookback - 1]
isLL = low[pivotLookback] < low[pivotLookback + 1] and low[pivotLookback] < low[pivotLookback - 1]

// ============================================
// TRACKING VARIABLES
// ============================================

var float highPivot = na
var float lowPivot = na
var float highestAfterPivot = na
var float lowestAfterPivot = na

// Update High Pivot
if isHH
    highPivot := high[pivotLookback]
    highestAfterPivot := high[pivotLookback]

if not na(highPivot) and high > highestAfterPivot
    highestAfterPivot := high

// Update Low Pivot
if isLL
    lowPivot := low[pivotLookback]
    lowestAfterPivot := low[pivotLookback]

if not na(lowPivot) and low < lowestAfterPivot
    lowestAfterPivot := low

// ============================================
// DIVERGENCE DETECTION
// ============================================

rsiPrev = rsi[1]
rsiPrev2 = rsi[2]

bearishDiv = isHH and rsi < rsiBearish and rsi < rsiPrev and rsiPrev > rsiPrev2
bullishDiv = isLL and rsi > rsiBullish and rsi > rsiPrev and rsiPrev < rsiPrev2

// ============================================
// FIBONACCI CALCULATIONS
// ============================================

var float buyEntry = na
var float buyExit = na
var float buySL = na

var float sellEntry = na
var float sellExit = na
var float sellSL = na

// BUY Setup
if bullishDiv and not na(lowPivot) and not na(highestAfterPivot)
    range = highestAfterPivot - lowPivot
    buyEntry := lowPivot + (range * fib618)
    buyExit := lowPivot + (range * fib50)
    buySL := lowPivot * (1 - slPercent / 100)

// SELL Setup
if bearishDiv and not na(highPivot) and not na(lowestAfterPivot)
    range = highPivot - lowestAfterPivot
    sellEntry := highPivot - (range * fib618)
    sellExit := highPivot - (range * fib50)
    sellSL := highPivot * (1 + slPercent / 100)

// ============================================
// ENTRY CONDITIONS
// ============================================

buySignal = bullishDiv and close >= lowPivot and close <= (lowPivot + atr * 2) and rsi > rsiBullish
sellSignal = bearishDiv and close <= highPivot and close >= (highPivot - atr * 2) and rsi < rsiBearish

// ============================================
// STRATEGY EXECUTION
// ============================================

// BUY ENTRY
if buySignal and strategy.position_size == 0
    strategy.entry("BUY", strategy.long, qty=1)
    if showAlerts
        alert("🟢 BUY ENTRY at " + str.tostring(close, "#.##"), alert.freq_once_per_bar)
    if showLabels
        label.new(bar_index, low - atr, "BUY", color=color.new(color.green, 60), textcolor=color.white, style=label.style_label_up)

// BUY EXIT
if not na(buyExit) and close >= buyExit and strategy.position_size > 0
    strategy.close("BUY", qty_percent=100)
    if showAlerts
        alert("✅ BUY EXIT at " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

// BUY STOP LOSS
if not na(buySL) and close <= buySL and strategy.position_size > 0
    strategy.close("BUY", qty_percent=100)
    if showAlerts
        alert("⛔ BUY STOP LOSS at " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

// SELL ENTRY
if sellSignal and strategy.position_size == 0
    strategy.entry("SELL", strategy.short, qty=1)
    if showAlerts
        alert("🔴 SELL ENTRY at " + str.tostring(close, "#.##"), alert.freq_once_per_bar)
    if showLabels
        label.new(bar_index, high + atr, "SELL", color=color.new(color.red, 60), textcolor=color.white, style=label.style_label_down)

// SELL EXIT
if not na(sellExit) and close <= sellExit and strategy.position_size > 0
    strategy.close("SELL", qty_percent=100)
    if showAlerts
        alert("✅ SELL EXIT at " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

// SELL STOP LOSS
if not na(sellSL) and close >= sellSL and strategy.position_size > 0
    strategy.close("SELL", qty_percent=100)
    if showAlerts
        alert("⛔ SELL STOP LOSS at " + str.tostring(close, "#.##"), alert.freq_once_per_bar)

// ============================================
// PLOTTING
// ============================================

plotshape(isHH, title="Higher High", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, offset=-pivotLookback)
plotshape(isLL, title="Lower Low", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, offset=-pivotLookback)

// Fib Lines
plot(not na(buyEntry) ? buyEntry : na, title="Buy Entry Fib", color=color.teal, linewidth=2)
plot(not na(buyExit) ? buyExit : na, title="Buy Exit Fib", color=color.yellow, linewidth=2)
plot(not na(sellEntry) ? sellEntry : na, title="Sell Entry Fib", color=color.blue, linewidth=2)
plot(not na(sellExit) ? sellExit : na, title="Sell Exit Fib", color=color.purple, linewidth=2)

// ============================================
// INFO TABLE
// ============================================

var table infoTable = na

if barstate.islast
    if na(infoTable)
        infoTable := table.new(position.top_right, 1, 6, bgcolor=color.new(color.black, 60), border_color=color.white)
    
    wins = strategy.wintrades
    losses = strategy.losingtrades
    winRate = wins > 0 and (wins + losses) > 0 ? (wins / (wins + losses)) * 100 : 0
    
    table.cell(infoTable, 0, 0, "📊 STATS", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 80))
    table.cell(infoTable, 0, 1, "Trades: " + str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 2, "Win %: " + str.tostring(winRate, "#.##") + "%", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 3, "Gross P: " + str.tostring(strategy.grossprofit, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 4, "Gross L: " + str.tostring(strategy.grossloss, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 5, "Net: " + str.tostring(strategy.netprofit, "#.##"), text_color=color.white, text_size=size.small)
